<!DOCTYPE html>
<html>
<head>
  <title>Admin Login</title>
</head>
<body>
  <h1>Login Admin</h1>
  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>
  <form action="/admin/login" method="POST">
    <label for="secret">Secret Key:</label>
    <input type="password" name="secret" id="secret" required>
    <button type="submit">Login</button>
  </form>
</body>
</html>
